# Public URL of this instance (reverse proxy terminates TLS in front).
BIKESHED_BASE_URL=https://bikeshed.example.com

# Where the SQLite file lives. In the container this is the mounted volume.
BIKESHED_DATABASE_URL=sqlite:////data/bikeshed.db

# Port the single service listens on.
PORT=8000

# Strava API application (https://www.strava.com/settings/api).
# Scopes used: profile:read_all,activity:read
STRAVA_CLIENT_ID=
STRAVA_CLIENT_SECRET=
# Must match the "Verify Token" you set when creating the Strava webhook subscription.
STRAVA_VERIFY_TOKEN=

# Shared secret for the nightly reconciliation endpoint.
BIKESHED_RECONCILE_TOKEN=
